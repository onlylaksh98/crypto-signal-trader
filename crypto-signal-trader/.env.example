# ============================================================
# CryptoSignal AI — Telegram Trading Terminal
# Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="CryptoSignal AI"
APP_ENV=development         # development | staging | production
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto_signal_trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://trader:CHANGE_ME_STRONG_PASSWORD@postgres:5432/crypto_signal_trader

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Telegram (Telethon) ---
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=CHANGE_ME
# Session string (generated on first authenticated run) — keep secret
TELEGRAM_SESSION_STRING=

# --- CCXT / Market Data ---
# Only public market-data endpoints are used (no private keys needed for paper trading)
MARKET_DATA_EXCHANGE=binance       # ccxt exchange id
MARKET_DATA_TIMEOUT_MS=10000

# --- Paper Trading Engine ---
PAPER_TRADING_ENABLED=true         # Must stay true. Live trading is NOT supported.
PAPER_INITIAL_BALANCE_USDT=10000.0
PAPER_DEFAULT_POSITION_SIZE_PCT=2.0   # % of equity per trade
PAPER_MAX_OPEN_POSITIONS=10
PAPER_SLIPPAGE_BPS=5                  # basis points slippage simulation

# --- Risk Engine ---
RISK_MAX_DRAWDOWN_PCT=20.0
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_POSITION_SIZE_PCT=10.0

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Binance Spot Testnet (optional sandbox — NOT used for default paper trading) ---
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_SECRET=

# --- RAG & AI Copilot (Optional: works offline with zero config if left empty) ---
# Supports Google Gemini, OpenAI, or smart local fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
RAG_PROVIDER=auto                   # auto | gemini | openai | local
RAG_TOP_K=5
RAG_AUTO_ENRICH_SIGNALS=true
